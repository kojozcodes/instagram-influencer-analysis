# Data provider: "mock" (no credentials, uses fixtures) or "graph" (real Instagram Graph API)
PROVIDER=mock

# --- Instagram Graph API settings (only needed when PROVIDER=graph) ---
# Graph API version
GRAPH_API_VERSION=v21.0
# The IG User ID of YOUR OWN connected Instagram Business/Creator account
# (this is the account that runs the business_discovery queries)
IG_USER_ID=
# Long-lived access token with instagram_basic + pages_show_list
# (or the token from the connected Facebook Page)
GRAPH_ACCESS_TOKEN=

# --- Token self-service page (/admin/token) ---
# The client pastes a fresh Graph API Explorer token there; the server exchanges it
# for a 60-day token itself, so renewals need no redeploy. Requires the app id +
# app secret (Meta app dashboard -> Settings -> Basic) and a password for the page.
GRAPH_APP_ID=
GRAPH_APP_SECRET=
ADMIN_PASSWORD=
# Where the renewed token is kept across restarts (default: <project>/data/token.json).
# On serverless hosts the file is not writable; the token then lives in memory only.
TOKEN_STORE_PATH=

# --- Analysis settings ---
# Max recent posts to pull per account (30 = enough for the 30-post averages)
RECENT_POSTS_LIMIT=30
# Max signals analyzed per account (spec section 9)
MAX_ANALYSIS_TARGETS=1000
